{
  "name": "fleet-management",
  "version": "1.0.0",
  "private": true,
  "license": "proprietary",
  "bin": {
    "fleet": "./cli/fleet.ts"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "ts-node src/Infra/migrate-cli.ts",
    "migrate:down": "ts-node src/Infra/migrate-down-cli.ts",
    "fleet": "ts-node cli/fleet.ts",
    "test": "cucumber-js --profile default",
    "test:critical": "cucumber-js --profile critical",
    "test:persistence": "cross-env FLEET_REPOSITORY=postgres cucumber-js --profile persistence",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:critical",
    "ci:full": "npm run ci && npm run migrate && npm run test:persistence"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "pg": "^8.14.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.11",
    "cross-env": "^7.0.3",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.0"
  }
}
